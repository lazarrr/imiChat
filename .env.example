# Copy to .env and adjust.  Every value overrides config/settings.py.

# ── Vector store — filled by the scraper (C:\Projects\scraper) ───────────
# Must be the same path / collection / embedding model the scraper writes to.
VECTOR_DB_PATH=./data/vector_store
CHROMA_COLLECTION=university_knowledge
# CHROMA_COLLECTION=university_knowledge_test   # e.g. after: run.py ingest --collection university_knowledge_test
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ── Retrieval ─────────────────────────────────────────────────────────────
# Chunks sent to the model per question. Keep this below 5 — more context
# makes the local model slower and its answers less focused.
TOP_K_RESULTS=3
# Hard ceiling: even if TOP_K_RESULTS (or `run.py eval -k`) asks for more.
MAX_CONTEXT_CHUNKS=4
RETRIEVAL_FETCH_K=20
SIMILARITY_THRESHOLD=0.7

# ── Better retrieval (optional) ───────────────────────────────────────────
# Each step can be switched on/off on its own.  Compare them first with
#   python run.py eval --compare
QUERY_SYNONYMS=false
HYBRID_SEARCH=false
RERANKER_ENABLED=false
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_DEVICE=cuda
# Drop chunks the reranker scores below this (0-1); 0 = keep all
# RERANKER_MIN_SCORE=0.0
# SYNONYMS_FILE=config/synonyms.txt
# EVAL_QUESTIONS_FILE=../scraper/eval_questions.yaml

# ── LLM backend ───────────────────────────────────────────────────────────
# True  = local Ollama server (LLM_OLLAMA_BASE_URL), the default
# False = remote OpenAI-compatible server (LLM_REMOTE_*)
LLM_USE_LOCAL=True

# Local Ollama (only when LLM_USE_LOCAL=True)
LLM_MODEL=qwen3.5:9b
LLM_OLLAMA_BASE_URL=http://localhost:11434
# Qwen3.5 reasons ("thinks") by default.  The chatbot only wants the answer,
# so thinking is switched off on every Ollama call (LLM_THINKING=True to keep it).
LLM_THINKING=False

# Remote OpenAI-compatible server (only when LLM_USE_LOCAL=False).
# BASE_URL is the API root; "/chat/completions" is appended to it.
# API_KEY is sent as "Authorization: Bearer <key>" (empty = no header).
LLM_REMOTE_BASE_URL=http://dyres.pmf.kg.ac.rs:11500/v1
LLM_REMOTE_MODEL=llama3.1:8b
LLM_REMOTE_API_KEY=change-me
LLM_REMOTE_TIMEOUT=300

# Generation settings shared by both backends
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_NUM_CTX=8192
# Loop guard: local repeat_penalty (1.0 = off) / repeat_last_n;
# remote frequency_penalty = repeat_penalty - 1
LLM_REPEAT_PENALTY=1.2
LLM_REPEAT_LAST_N=256

# ── API ───────────────────────────────────────────────────────────────────
# Max /chat requests per minute per client IP (0 = no limit)
RATE_LIMIT=100
# Optional: keep chat sessions and rate-limit counters in Redis, so they are
# shared by all API workers and survive restarts (default: in memory)
# REDIS_URL=redis://localhost:6379/0

# ── Request log (read by the separate visualization project) ──────────────
# One JSON object per answered turn: the question as typed, the rewrite
# prompt and result, every retrieval attempt, the chunks sent to the LLM,
# the answer and per-stage timings.  This project only writes the file.
REQUEST_LOG_ENABLED=true
REQUEST_LOG_PATH=./logs/requests.jsonl
REQUEST_LOG_MAX_BYTES=20000000
REQUEST_LOG_BACKUPS=5
# Per-field cap in characters for prompts, chunk bodies and history text
REQUEST_LOG_MAX_TEXT=8000
# Chunks dropped during retrieval to log per turn (the total is always logged)
REQUEST_LOG_MAX_EXCLUDED=40
