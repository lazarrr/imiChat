# Copy to .env and adjust.  Every value overrides config/settings.py.

# ── Vector store — filled by the scraper (C:\Projects\scraper) ───────────
# Must be the same path / collection / embedding model the scraper writes to.
VECTOR_DB_PATH=./data/vector_store
CHROMA_COLLECTION=university_knowledge
# CHROMA_COLLECTION=university_knowledge_test   # e.g. after: run.py ingest --collection university_knowledge_test
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ── Retrieval ─────────────────────────────────────────────────────────────
TOP_K_RESULTS=5
RETRIEVAL_FETCH_K=20
SIMILARITY_THRESHOLD=0.7

# ── Better retrieval (optional) ───────────────────────────────────────────
# Each step can be switched on/off on its own.  Compare them first with
#   python run.py eval --compare
QUERY_SYNONYMS=false
HYBRID_SEARCH=false
RERANKER_ENABLED=false
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_DEVICE=cuda
# Drop chunks the reranker scores below this (0-1); 0 = keep all
# RERANKER_MIN_SCORE=0.0
# SYNONYMS_FILE=config/synonyms.txt
# EVAL_QUESTIONS_FILE=../scraper/eval_questions.yaml

# ── LLM (Ollama) ──────────────────────────────────────────────────────────
LLM_MODEL=llama3.1:latest
LLM_TEMPERATURE=0.0
LLM_NUM_CTX=8192

# ── API ───────────────────────────────────────────────────────────────────
# Max /chat requests per minute per client IP (0 = no limit)
RATE_LIMIT=100
# Optional: keep chat sessions and rate-limit counters in Redis, so they are
# shared by all API workers and survive restarts (default: in memory)
# REDIS_URL=redis://localhost:6379/0
