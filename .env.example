# LLM backend: True = local Ollama, False = remote OpenAI-compatible server
LLM_USE_LOCAL=False

# Local Ollama
LLM_MODEL=llama3.1:latest
LLM_OLLAMA_BASE_URL=http://localhost:11434

# Remote OpenAI-compatible server (used when LLM_USE_LOCAL=False)
LLM_REMOTE_BASE_URL=http://dyres.pmf.kg.ac.rs:11500/v1
LLM_REMOTE_MODEL=llama3.1:8b
LLM_REMOTE_API_KEY=change-me
LLM_REMOTE_TIMEOUT=300

# Repetition control (raise if answers loop; 1.0 = off)
LLM_REPEAT_PENALTY=1.2
LLM_REPEAT_LAST_N=256

# Answer provenance: attach the exact context chunks used by the answer
# to each cited source (shown in the web UI). Set to False to omit them.
EXPOSE_ANSWER_CHUNKS=True
ANSWER_CHUNK_MAX_CHUNKS=3
ANSWER_CHUNK_CHAR_LIMIT=600
